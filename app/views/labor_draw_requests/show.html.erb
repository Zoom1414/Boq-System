<div class="finance-heading no-print"><div><p class="eyebrow">LABOR DRAW REQUEST</p><h2><%= @draw.dv_number %> <span class="section-code purple">DV</span></h2><p><%= @draw.project.name %> / <%= @draw.house_plan.name %></p></div><button class="btn btn-secondary" data-controller="print" data-action="print#print">พิมพ์เอกสาร</button></div>
<% if @error %><div class="alert" role="alert"><%= @error %></div><% end %>
<article class="finance-card print-document"><div class="finance-card-heading"><div><p class="eyebrow">SITEWORK / LABOR PAYMENT</p><h2>ใบขอเบิกค่าแรง</h2><p><%= @draw.dv_number %></p></div><%= finance_status(@draw) %></div>
<div class="document-meta"><div><label>ผู้รับเหมา / ช่าง</label><strong><%= @draw.contractor_name %></strong></div><div><label>วันที่ขอเบิก</label><strong><%= thai_date(@draw.request_date) %></strong></div><div><label>ผู้ทำรายการ</label><strong><%= @draw.user.name %></strong></div><div><label>โครงการ / แปลน</label><strong><%= @draw.project.name %> / <%= @draw.house_plan.name %></strong></div></div>
<div id="budget_warnings"><%= render "shared/budget_warnings", warnings: @draw.budget_warnings if @draw.pending? %></div>
<div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>รายการงาน</th><th class="number">งบรวม</th><th class="number">จ่ายก่อนงวดนี้</th><th class="number labor-cell">ขอเบิก</th><th class="number">คงเหลือหลังงวดนี้</th></tr></thead><tbody><% @draw.labor_draw_items.each do |row| %><tr><td class="strong"><%= row.work_description %><small><%= row.boq_item.code %></small></td><td class="number"><%= baht(row.budget_total) %></td><td class="number green-text"><%= baht(row.paid_amount) %></td><td class="number labor-cell strong"><%= baht(row.requested_amount) %></td><td class="number"><%= baht(row.remaining_amount) %></td></tr><% end %></tbody></table></div>
<div class="finance-total-line">รวมยอดขอเบิก <strong class="purple-text"><%= baht(@draw.total_requested_amount) %></strong></div>
<div class="document-note">ยอดในตารางเป็นข้อมูล ณ วันที่ขอเบิก หรือวันที่อนุมัติ ระบบตรวจงบคงเหลือปัจจุบันอีกครั้งก่อนอนุมัติ</div>
<% if @draw.approved? %><div class="document-note">อนุมัติโดย <%= @draw.approved_by.name %> · <%= thai_date(@draw.approved_at.to_date) %><% if @draw.budget_override? %><br>เหตุผลอนุมัติเกินงบ: <%= @draw.override_reason %><% end %></div><% end %>
<% if @draw.admin_note.present? %><div class="document-note">หมายเหตุ Admin: <%= @draw.admin_note %></div><% end %>
</article>
<% if @draw.pending? && policy(@draw).approve? %><div class="finance-card approval-actions no-print"><%= form_with url: approve_labor_draw_request_path(@draw), method: :patch do |f| %><div class="section-heading"><span class="document-icon purple"><%= ui_icon(:check) %></span><div><h3>ตรวจสอบและอนุมัติค่าแรง</h3><p class="form-hint">เมื่ออนุมัติ ระบบจะหักยอดจาก BOQ ทันที</p></div></div><%= f.label :admin_note, "หมายเหตุการอนุมัติ (ไม่บังคับ)", class: "mt-5" %><%= f.text_area :admin_note, rows: 2, placeholder: "เช่น ตรวจรับผลงานเรียบร้อยแล้ว" %><%= render "finance/override" %><%= f.submit "อนุมัติเบิกค่าแรง", class: "btn btn-purple", data: { turbo_submits_with: "กำลังอนุมัติ…" } %><% end %><%= render "finance/reject", url: reject_labor_draw_request_path(@draw) %></div><% end %>
