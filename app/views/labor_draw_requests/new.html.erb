<div class="finance-heading"><div><p class="eyebrow">LABOR PAYMENT / DRAW REQUEST</p><h2>เบิกจ่ายค่าแรง <span class="section-code purple">DV</span></h2><p>ตรวจงบคงเหลือและขอเบิกค่าแรงตามผลงานของผู้รับเหมา</p></div><%= link_to "ประวัติเบิกค่าแรง ↗", labor_draw_requests_path(workspace_params), class: "btn btn-secondary" %></div>
<div class="finance-card contractor-card"><span class="document-icon purple"><%= ui_icon(:home) %></span><%= form_with url: new_labor_draw_request_path, method: :get, data: { turbo_frame: "labor-items" } do |f| %><%= f.hidden_field :project_id, value: @nav_project&.id %><%= f.hidden_field :house_plan_id, value: @nav_plan&.id %><%= f.label :contractor_name, "ผู้รับเหมา / ช่าง" %><%= f.select :contractor_name, @contractors, { selected: @draw.contractor_name, include_blank: @contractors.empty? ? "ยังไม่มีผู้รับเหมาที่กำหนดใน BOQ" : false }, data: { action: "change->boq#navigate" } %><% end %><p>ดึงรายการจากผู้รับเหมา<br>ที่กำหนดไว้ใน Master BOQ</p></div>
<%= turbo_frame_tag "labor-items" do %>
<div id="budget_warnings"></div><div id="finance-form">
<% if @items.any? %>
<%= form_with model: @draw, data: { controller: "finance", finance_mode_value: "dv", action: "input->finance#calculate", turbo_frame: "_top" }, class: "finance-card" do |f| %>
<%= render "shared/form_errors", record: @draw %>
<%= f.hidden_field :project_id, value: @nav_project&.id %><%= f.hidden_field :house_plan_id, value: @nav_plan&.id %><%= f.hidden_field :contractor_name %>
<div class="finance-card-heading"><div><h3>รายการงานของ <%= @draw.contractor_name %></h3><p><%= @items.size %> รายการ · กรอกเฉพาะรายการที่ต้องการเบิก</p></div><div><%= f.label :request_date, "วันที่ขอเบิก *" %><%= f.date_field :request_date, required: true %></div></div>
<div class="finance-table-wrap"><table class="finance-table labor-table"><thead><tr><th>#</th><th>รายการงาน</th><th class="number">ปริมาณ</th><th class="number">ค่าแรง / หน่วย</th><th class="number">งบรวม</th><th class="number">จ่ายแล้ว</th><th class="number">รออนุมัติ</th><th class="number labor-cell">ขอเบิก (บาท)</th><th class="number">เหลือหลังขอเบิก</th></tr></thead><tbody>
<% @items.each_with_index do |item, index| %><tr data-finance-target="row" data-remaining="<%= item.labor_remaining_amount %>"><td class="row-index"><%= index + 1 %></td><td class="strong"><%= item.name %><small><%= item.code %></small></td><td class="number"><%= item.material_quantity.to_fs(:delimited) %> <small><%= item.unit %></small></td><td class="number"><%= baht(item.labor_unit_price) %></td><td class="number strong"><%= baht(item.labor_total) %></td><td class="number green-text"><%= baht(item.labor_paid_amount) %></td><td class="number amber-text"><%= baht(item.pending_labor_amount) %></td><td class="labor-cell"><%= hidden_field_tag "labor_draw_request[labor_draw_items_attributes][#{index}][boq_item_id]", item.id %><%= number_field_tag "labor_draw_request[labor_draw_items_attributes][#{index}][requested_amount]", @draw.labor_draw_items.find { |row| row.boq_item_id == item.id }&.requested_amount || 0, min: 0, step: "0.01", aria: { label: "ขอเบิก #{item.name}" }, data: { field: "requested" } %></td><td class="number strong" data-field="remaining"><%= baht(item.labor_remaining_amount) %></td></tr><% end %>
</tbody></table></div>
<div class="document-note" data-finance-target="warning" role="alert" hidden>ยอดขอเบิกเกินงบ BOQ ต้องให้ Admin อนุมัติเกินงบพร้อมระบุเหตุผล</div>
<div class="finance-footer"><div><span class="eyebrow">ยอดขอเบิกครั้งนี้</span><strong class="grand-total purple-text" data-finance-target="total">0.00</strong><span>บาท</span><p class="form-hint">ยอดรออนุมัติยังไม่หักจากงบหลัก</p></div><%= f.submit "ส่งคำขอเบิกค่าแรง →", class: "btn btn-purple", data: { turbo_submits_with: "กำลังส่งคำขอ…" } %></div>
<% end %>
<% else %><div class="finance-card"><%= render "finance/empty", title: "ยังไม่มีรายการงานของผู้รับเหมา", description: "เพิ่มชื่อผู้รับเหมาและงบค่าแรงให้รายการใน Master BOQ ก่อนเริ่มเบิก" %></div><% end %>
</div><% end %>
