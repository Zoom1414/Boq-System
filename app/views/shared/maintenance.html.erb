<!DOCTYPE html>
<html lang="th">
<head>
  <title>ปิดปรับปรุงระบบ · SITEWORK</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "tailwind" %>
</head>
<body>
<div class="dp-maintenance">
  <div class="dp-maintenance-card">
    <span class="dp-maintenance-icon"><%= ui_icon(:settings, css: "size-8") %></span>
    <p class="eyebrow">MAINTENANCE</p>
    <h1>ปิดปรับปรุงระบบชั่วคราว</h1>
    <p><%= SystemSetting.value(:maintenance_message) %></p>
    <%= button_to "ออกจากระบบ", destroy_user_session_path, method: :delete, class: "btn btn-secondary", form: { data: { turbo: false } } %>
  </div>
</div>
</body>
</html>
