<div class="finance-heading"><div><p class="eyebrow">COMPLETED PROCUREMENT</p><h2>ประวัติการจัดซื้อ <span class="section-code green">PU</span></h2><p>ยอดซื้อ / จ้างจริงที่ได้รับการอนุมัติแล้ว</p></div></div>
<div class="finance-card"><% if @orders.any? %><div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>เลขที่ PU</th><th>อ้างอิง PO</th><th>วันที่ซื้อ / จ้างจริง</th><th>ร้านค้า / ผู้รับจ้าง</th><th class="number">ยอดรวมจ่ายจริง</th><th></th></tr></thead><tbody><% @orders.each do |order| %><tr><td><%= link_to order.pu_number || "อนุมัติก่อนระบบ PU", purchase_order_path(order), class: "document-link green-text" %></td><td><%= order.po_number %></td><td><%= thai_date(order.procurement_date || order.approved_at&.to_date) %></td><td><%= order.vendor_name %></td><td class="number strong"><%= baht(order.grand_total) %></td><td><%= link_to "ดู / พิมพ์ ↗", purchase_order_path(order), class: "muted-link" %></td></tr><% end %></tbody></table></div><% else %><%= render "finance/empty", title: "ยังไม่มีประวัติการจัดซื้อ" %><% end %></div>
