<div class="finance-heading"><div><p class="eyebrow">PROCUREMENT QUEUE</p><h2>รอจัดซื้อ / จัดจ้าง <span class="section-code blue">PU</span></h2><p>ตรวจสอบใบสั่งซื้อและบันทึกราคาจริงก่อนอนุมัติ</p></div><span class="count-chip"><%= @orders.size %> เอกสารรอดำเนินการ</span></div>
<div class="request-stack"><% @orders.each do |order| %><%= link_to policy(order).approve? ? procure_purchase_order_path(order) : purchase_order_path(order), class: "request-card", data: policy(order).approve? ? { turbo_frame: "boq_editor" } : {} do %><span class="document-icon blue"><%= ui_icon(:wallet) %></span><div class="request-main"><strong><%= order.po_number %></strong><p><%= order.vendor_name %> <span>· <%= thai_date(order.order_date) %></span></p></div><div class="request-value"><%= finance_status(order) %><p><%= order.po_items.size %> รายการ <b><%= baht(order.grand_total) %></b></p></div><span class="workflow-next-action"><%= policy(order).approve? ? "บันทึกราคาจริง →" : "ดูใบสั่งซื้อ →" %></span><% end %><% end %></div>
<% if @orders.empty? %><div class="finance-card"><%= render "finance/empty", title: "ไม่มีรายการรอจัดซื้อ", description: "ใบสั่งซื้อที่ส่งมาใหม่จะแสดงในหน้านี้" %></div><% end %>
