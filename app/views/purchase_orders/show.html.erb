<div class="finance-heading no-print"><div><p class="eyebrow">PURCHASE DOCUMENT</p><h2><%= @order.po_number %></h2><p><%= @order.project.name %> / <%= @order.house_plan.name %></p></div><div class="flex flex-wrap gap-3"><button class="btn btn-secondary" data-controller="print" data-action="print#print">พิมพ์เอกสาร</button><% if @order.pending_pu? && policy(@order).approve? %><%= link_to "บันทึกจัดซื้อ (PU)", procure_purchase_order_path(@order), data: { turbo_frame: "boq_editor" }, class: "btn btn-blue" %><% end %></div></div>
<article class="finance-card print-document"><div class="finance-card-heading"><div><p class="eyebrow">SITEWORK / PURCHASE ORDER</p><h2>ใบสั่งซื้อ / สั่งจ้าง</h2><p><%= @order.po_number %><% if @order.pu_number %> · <%= @order.pu_number %><% end %></p></div><%= finance_status(@order) %></div>
<div class="document-meta"><div><label>ร้านค้า / ผู้รับจ้าง</label><strong><%= @order.vendor_name %></strong></div><div><label>วันที่สั่งซื้อ</label><strong><%= thai_date(@order.order_date) %></strong></div><div><label>โครงการ / แปลน</label><strong><%= @order.project.name %> / <%= @order.house_plan.name %></strong></div><% if @order.approved? %><div><label>วันที่จัดซื้อ / ผู้อนุมัติ</label><strong><%= thai_date(@order.procurement_date || @order.approved_at.to_date) %> · <%= @order.approved_by.name %></strong></div><% end %></div>
<div id="budget_warnings"><%= render "shared/budget_warnings", warnings: @order.budget_warnings unless @order.approved? %></div>
<div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>รายการ</th><th class="number">จำนวน</th><th class="number">วัสดุ / หน่วย PO</th><th class="number">วัสดุจริง / หน่วย</th><th class="number material-cell">รวมวัสดุ</th><th class="number labor-cell">รวมค่าแรง</th><th class="number">รวม</th></tr></thead><tbody><% @order.po_items.each do |row| %><tr><td class="strong"><%= row.item_name %><small><%= row.boq_item_id ? row.boq_item.code : "นอก BOQ · ไม่มีการหักงบหลัก" %></small></td><td class="number"><%= row.quantity.to_fs(:delimited) %> <%= row.unit || row.boq_item&.unit %></td><td class="number"><%= baht(row.material_unit_price) %></td><td class="number"><%= row.actual_material_unit_price ? baht(row.actual_material_unit_price) : "—" %></td><td class="number material-cell"><%= baht(row.material_amount) %></td><td class="number labor-cell"><%= baht(row.labor_amount) %></td><td class="number strong"><%= baht(row.total_amount) %></td></tr><% end %></tbody></table></div>
<div class="finance-total-line">ยอดรวมทั้งสิ้น <strong><%= baht(@order.grand_total) %></strong></div>
<% if @order.budget_override? %><div class="document-note">อนุมัติเกินงบ: <%= @order.override_reason %></div><% end %><% if @order.admin_note.present? %><div class="document-note">หมายเหตุ Admin: <%= @order.admin_note %></div><% end %>
</article>
<% if @order.pending_pu? && policy(@order).approve? %><%= render "finance/reject", url: reject_purchase_order_path(@order) %><% end %>
