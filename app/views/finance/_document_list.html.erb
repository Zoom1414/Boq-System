<% if documents.any? %><div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>เลขที่เอกสาร</th><th>วันที่</th><th>ร้านค้า / ผู้รับเหมา</th><th>รายการ</th><th class="number">มูลค่ารวม</th><th>สถานะ</th><th></th></tr></thead><tbody>
<% documents.each do |document| %><tr><td><%= link_to document_number(document), polymorphic_path(document), class: "document-link" %><small><%= document.is_a?(PurchaseOrder) ? "PURCHASE ORDER" : "LABOR DRAW" %></small></td><td><%= thai_date(document.is_a?(PurchaseOrder) ? document.order_date : document.request_date) %></td><td><%= document_vendor(document) %></td><td><span class="count-chip"><%= document.line_items.size %> รายการ</span></td><td class="number strong"><%= number_with_precision(document_amount(document), precision: 2, delimiter: ",") %></td><td><%= finance_status(document) %></td><td class="workflow-next-action"><%= link_to (document.is_a?(LaborDrawRequest) && document.pending? && policy(document).approve?) ? "ตรวจและอนุมัติ" : "ดูเอกสาร", polymorphic_path(document), class: "btn btn-secondary" %></td></tr><% end %>
</tbody></table></div><% else %><%= render "finance/empty" %><% end %>
