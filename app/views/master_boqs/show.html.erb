<section class="boq-workspace">
  <div class="boq-toolbar">
    <strong>Master BOQ</strong>
    <input type="search" class="boq-search" placeholder="ค้นหารายการ, หมวด, ช่าง..." aria-label="ค้นหารายการ BOQ" data-boq-target="search" data-action="input->boq#filter">
    <div class="boq-primary-actions">
      <% if @master && policy(@master).update? %>
        <%= link_to "+ เพิ่มหมวดงาน", new_master_boq_boq_category_path(@master), class: "boq-button", data: { turbo_frame: "boq_editor" } %>
        <%= render "category_select" %>
        <%= render "add_item_button" %>
      <% end %>
      <details class="boq-view-options"><summary class="boq-button">มุมมองและสำรองข้อมูล ▾</summary><div>
        <button type="button" class="boq-button" data-action="boq#expandAll">แสดงทุกหมวด</button>
        <button type="button" class="boq-button" data-action="boq#collapseAll">ย่อทุกหมวด</button>
        <button type="button" class="boq-button" data-action="boq#toggleFullscreen">ขยายพื้นที่ตาราง</button>
        <% if @master %><%= link_to "ดาวน์โหลดสำรอง BOQ", backup_master_boq_path(@master), class: "boq-button", data: { turbo: false } %><% end %>
      </div></details>
    </div>
  </div>
  <p class="boq-guide">เริ่มจากเพิ่มหมวดงาน แล้วเพิ่มรายการในหมวด · คลิกชื่อรายการเพื่อแก้ไขและบันทึก</p>
  <%= render "summary" %>
  <%= render "worksheet" %>
  <div class="boq-statusbar"><span>คลิกชื่อรายการเพื่อดูหรือแก้ไข · ยอดเงินเป็นบาท</span><span>รอ PO = จำนวนที่รออนุมัติ · ยอดใช้และจ่ายหักเมื่ออนุมัติ</span></div>
</section>
