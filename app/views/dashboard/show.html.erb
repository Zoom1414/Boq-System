<div class="finance-heading"><div><p class="eyebrow">PROJECT OVERVIEW</p><h2><%= @nav_project&.name || "ยินดีต้อนรับสู่ SITEWORK" %></h2><p><%= @nav_plan ? "สรุปงบประมาณและเอกสารของแปลน #{@nav_plan.name}" : "เริ่มต้นด้วยการสร้างโครงการและแปลนบ้านของคุณ" %></p></div><%= link_to "จัดการโครงการ ↗", projects_path, class: "btn btn-secondary" %></div>
<div class="dashboard-stats"><div class="dashboard-stat featured"><span>งบประมาณ Master BOQ</span><strong><%= baht((@master&.total_material_budget || 0) + (@master&.total_labor_budget || 0)) %></strong><small>วัสดุ + ค่าแรง ตามแปลน</small><%= ui_icon(:building, css: "stat-watermark") %></div><div class="dashboard-stat"><span>ค่าวัสดุที่อนุมัติ</span><strong><%= baht(@material_spent) %></strong><small class="blue-text">ราคาซื้อจริงจาก PU</small></div><div class="dashboard-stat"><span>ค่าแรงที่อนุมัติ</span><strong><%= baht(@labor_spent) %></strong><small class="purple-text">ค่าแรงจาก PO + DV</small></div><div class="dashboard-stat"><span>ยอดคำขอรออนุมัติ</span><strong><%= baht(@pending_total) %></strong><small class="amber-text">ยังไม่หักจากงบหลัก</small></div></div>
<% if current_user.admin? || current_user.project_engineer? %>
<div class="quick-actions" aria-label="เริ่มทำรายการ">
  <%= link_to new_labor_draw_request_path(workspace_params), class: "quick-action", data: { turbo_frame: "workspace_content" } do %><span class="document-icon purple"><%= ui_icon(:wallet) %></span><div><strong>เบิกค่าแรงให้ช่าง</strong><small><%= current_user.admin? ? "เลือกช่าง ใส่ยอด แล้วเบิกได้ทันที" : "เลือกช่าง ใส่ยอด ส่งให้ Admin อนุมัติ" %></small></div><span>→</span><% end %>
  <%= link_to new_purchase_order_path(workspace_params), class: "quick-action", data: { turbo_frame: "workspace_content" } do %><span class="document-icon blue"><%= ui_icon(:building) %></span><div><strong>เปิดใบสั่งซื้อ / จ้าง</strong><small>เลือกรายการจาก BOQ แล้วส่งจัดซื้อ</small></div><span>→</span><% end %>
  <%= link_to approvals_path(workspace_params), class: "quick-action", data: { turbo_frame: "workspace_content" } do %><span class="document-icon"><%= ui_icon(:check) %></span><div><strong><%= current_user.admin? ? "ตรวจคำขอรออนุมัติ" : "ติดตามสถานะคำขอ" %></strong><small>ดูเอกสารและขั้นตอนถัดไป</small></div><span>→</span><% end %>
</div>
<% end %>
<%= render "progress" %>
<div class="dashboard-links"><%= link_to master_boq_path(workspace_params), class: "dashboard-link" do %><span class="document-icon"><%= ui_icon(:grid) %></span><div><h3>ตรวจงบประมาณ</h3><p>Master BOQ · วัสดุและค่าแรง</p></div><span>↗</span><% end %><%= link_to pending_purchase_orders_path(workspace_params), class: "dashboard-link" do %><span class="document-icon blue"><%= ui_icon(:wallet) %></span><div><h3>จัดซื้อ / จัดจ้าง</h3><p>ตรวจราคาและอนุมัติ PU</p></div><span>↗</span><% end %><%= link_to approvals_path(workspace_params), class: "dashboard-link" do %><span class="document-icon purple"><%= ui_icon(:check) %></span><div><h3>ตรวจคำขออนุมัติ</h3><p>เอกสาร PO และ DV</p></div><span>↗</span><% end %></div>
<div class="section-heading mb-4 mt-8"><h3>เอกสารล่าสุด</h3></div><div class="finance-card"><%= render "finance/document_list", documents: @recent %></div>
<p class="form-hint mt-4">ยอดใช้จ่ายรวมรายการนอก BOQ ที่อนุมัติแล้ว ส่วนยอดคงเหลือรายรายการดูได้ที่ Master BOQ</p>
