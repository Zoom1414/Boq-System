<% content_for :title, @project.name %>
<%= link_to "← โครงการทั้งหมด", projects_path, class: "text-link mb-6 inline-block" %>
<div class="page-heading">
  <div><p class="eyebrow"><%= @project.code %></p><h1 class="page-title"><%= @project.name %></h1><p class="page-description flex items-center gap-2"><%= ui_icon(:pin, css: "size-4") %><%= @project.location.presence || "ยังไม่ระบุสถานที่" %></p></div>
  <%= project_status_badge(@project) %>
</div>
<div class="grid items-start gap-6 lg:grid-cols-3">
  <section class="panel p-6 sm:p-8 lg:col-span-2">
    <h2 class="mb-4 text-lg font-bold">รายละเอียดโครงการ</h2>
    <div class="whitespace-pre-line text-sm leading-8 text-slate-500"><%= @project.description.presence || "ยังไม่มีรายละเอียดโครงการ" %></div>
    <dl class="mt-8 grid gap-5 border-t border-slate-100 pt-6 sm:grid-cols-2">
      <div><dt class="text-xs text-slate-400">รหัสโครงการ</dt><dd class="mt-2 font-medium"><%= @project.code %></dd></div>
      <div><dt class="text-xs text-slate-400">วันที่สร้างโครงการ</dt><dd class="mt-2 font-medium"><%= @project.created_at.strftime("%d/%m/%Y") %></dd></div>
    </dl>
    <% if policy(@project).update? %>
      <div class="form-actions"><%= link_to "แก้ไขโครงการ", edit_project_path(@project), class: "btn btn-secondary" %>
        <%= button_to "ลบโครงการ", @project, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "ต้องการลบโครงการนี้หรือไม่?" } } %>
      </div>
    <% end %>
  </section>
  <section class="panel p-6">
    <span class="icon-box mb-5 bg-amber-50 text-amber-700"><%= ui_icon(:home) %></span><h2 class="text-lg font-bold">แปลนบ้านในโครงการ</h2>
    <p class="mt-4 text-4xl font-bold"><%= @project.house_plans.count %><span class="ml-2 text-sm font-normal text-slate-400">แปลน</span></p>
    <p class="mt-4 text-sm leading-7 text-slate-500">จัดการแบบบ้านและรหัสแปลน<br>ของโครงการนี้</p>
    <%= link_to project_house_plans_path(@project), class: "btn btn-primary mt-6 w-full" do %>ดูแปลนบ้าน <%= ui_icon(:arrow, css: "size-4") %><% end %>
  </section>
</div>
