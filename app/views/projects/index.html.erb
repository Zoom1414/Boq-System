<% content_for :title, "โครงการก่อสร้าง" %>
<div class="page-heading">
  <div><p class="eyebrow">PROJECT OVERVIEW</p><h1 class="page-title">โครงการก่อสร้าง</h1><p class="page-description">ภาพรวมโครงการและงบประมาณทั้งหมดของคุณในที่เดียว</p></div>
  <% if policy(Project).create? %><%= link_to new_project_path, class: "btn btn-primary" do %><%= ui_icon(:plus) %> เพิ่มโครงการ<% end %><% end %>
</div>
<div class="mb-10 grid gap-4 sm:grid-cols-3">
  <div class="stat-card"><div><p class="stat-label">โครงการทั้งหมด</p><p class="stat-value"><%= @projects.size %><span class="ml-2 text-xs font-normal text-slate-400">โครงการ</span></p></div><span class="icon-box"><%= ui_icon(:building) %></span></div>
  <div class="stat-card"><div><p class="stat-label">กำลังก่อสร้าง</p><p class="stat-value"><%= @projects.count(&:active?) %><span class="ml-2 text-xs font-normal text-slate-400">โครงการ</span></p></div><span class="icon-box bg-emerald-50 text-emerald-600"><%= ui_icon(:home) %></span></div>
  <div class="stat-card"><div><p class="stat-label">งบประมาณ BOQ รวม</p><p class="mt-4 text-xl font-bold tracking-tight text-slate-900 xl:text-2xl"><%= baht(@project_budgets.values.sum) %></p></div><span class="icon-box bg-amber-50 text-amber-700"><%= ui_icon(:wallet) %></span></div>
</div>
<div class="mb-5 flex items-center justify-between"><h2 class="text-base font-semibold">รายการโครงการ <span class="ml-2 text-sm font-normal text-slate-400"><%= @projects.size %> รายการ</span></h2><span class="text-xs text-slate-400">เรียงจากโครงการล่าสุด</span></div>
<% if @projects.empty? %>
  <div class="empty-state"><span class="icon-box mx-auto mb-5"><%= ui_icon(:building) %></span><h2 class="text-lg font-semibold">เริ่มต้นโครงการแรกของคุณ</h2><p class="mt-3 text-sm leading-7 text-slate-500">เพิ่มข้อมูลโครงการ แล้วจัดเตรียมแปลนบ้านสำหรับงานก่อสร้าง</p>
    <% if policy(Project).create? %><%= link_to "เพิ่มโครงการ", new_project_path, class: "btn btn-primary mt-6" %><% end %>
  </div>
<% else %>
  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    <% @projects.each do |project| %>
      <article class="project-card">
        <div class="flex-1 p-6">
          <div class="mb-6 flex items-center justify-between gap-3"><span class="icon-box"><%= ui_icon(:building) %></span><%= project_status_badge(project) %></div>
          <p class="mb-2 text-xs font-medium tracking-wide text-slate-400"><%= project.code %></p>
          <h3 class="text-lg leading-7 font-bold"><%= link_to project.name, project, class: "hover:text-amber-700" %></h3>
          <p class="mt-3 flex items-start gap-2 text-sm text-slate-500"><%= ui_icon(:pin, css: "mt-0.5 size-4 shrink-0") %><%= project.location.presence || "ยังไม่ระบุสถานที่" %></p>
          <p class="mt-4 line-clamp-2 min-h-12 text-sm leading-6 text-slate-500"><%= project.description.presence || "ยังไม่มีรายละเอียดโครงการ" %></p>
          <div class="mt-6 grid grid-cols-2 gap-3 border-t border-slate-100 pt-5">
            <div><p class="text-xs text-slate-400">แปลนบ้าน</p><p class="mt-2 text-sm font-semibold"><%= project.house_plans.size %> แปลน</p></div>
            <div><p class="text-xs text-slate-400">งบประมาณ BOQ</p><p class="mt-2 text-sm font-semibold"><%= baht(@project_budgets[project.id]) %></p></div>
          </div>
        </div>
        <%= link_to project, class: "flex items-center justify-between border-t border-slate-100 bg-slate-50/60 px-6 py-4 text-sm font-semibold text-slate-600 hover:bg-amber-50 hover:text-amber-800" do %>ดูรายละเอียดโครงการ <%= ui_icon(:arrow, css: "size-4") %><% end %>
      </article>
    <% end %>
  </div>
<% end %>
